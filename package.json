{
  "name": "garden-console",
  "version": "1.0.0",
  "description": "hrt, mood, weekly updates and readlogs tracker.",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "oxlint . && tsc -b --pretty false",
    "deploy": "tsc -b && vite build && wrangler deploy",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "worker:dev": "tsc -b && vite build && wrangler dev"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.77",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  }
}
