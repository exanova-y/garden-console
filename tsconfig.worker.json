{
  "compilerOptions": {
    "typeRoots": ["./node_modules/@types", "./node_modules/@cloudflare"],
    "types": ["workers-types", "node"],
    "lib": ["ES2022", "WebWorker"],
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/server",
    "src/features/identity/index.ts",
    "src/features/identity/routes.ts",
    "src/features/identity/validation.ts",
    "src/features/identity/totp.ts",
    "src/features/identity/rate-limit.ts",
    "src/features/vault",
    "src/features/reading/index.ts",
    "src/features/reading/routes.ts",
    "src/features/reading/server-crypto.ts",
    "src/features/reading/types.ts"
  ]
}
